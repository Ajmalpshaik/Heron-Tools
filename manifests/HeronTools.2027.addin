<?xml version="1.0" encoding="utf-8"?>
<!--
  Heron Tools - add-in manifest for Revit 2027.

  build/build.ps1 copies this file to %AppData%\Autodesk\Revit\Addins\2027\HeronTools.addin
  and the DLL to the HeronTools folder beside it. The Assembly path below is relative to
  this manifest, so it points into that folder.

  The AddInId is unique to Heron Tools for Revit 2027. Never reuse it in another product.
  Only these elements: the Revit 2026 isolation settings element crashes Revit 2025 and older.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Heron Tools</Name>
    <Assembly>HeronTools\HeronTools.dll</Assembly>
    <AddInId>7AEDA3E0-2F26-4086-BC62-C58A5FD0C54D</AddInId>
    <FullClassName>HeronTools.App.HeronToolsApp</FullClassName>
    <VendorId>AJPS</VendorId>
    <VendorDescription>Ajmal PS - Heron Tools</VendorDescription>
  </AddIn>
</RevitAddIns>
