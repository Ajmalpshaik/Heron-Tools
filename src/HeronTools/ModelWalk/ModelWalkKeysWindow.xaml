<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.2.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Model Walk - Key Settings (pause the walk, press K). Click a key, then press the key you want. A key another
  action has is swapped with it (and the window says so). Reset to standard keys puts every key back.
  Heron brand (UI/HeronStyles.xaml): header with the mark, rows on Surface, footer status on the left, then ONE
  Accent button (Save) and Cancel, as in every Heron Tools window.
-->
<Window x:Class="HeronTools.UI.ModelWalk.ModelWalkKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Walk Keys - Heron Tools"
        Width="560"
        Height="720"
        MinWidth="500"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HeronTools;component/UI/HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Model Walk keys" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Click a key, then press the one you want." Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rows -->
        <DockPanel Grid.Row="1" Margin="24,14,24,10">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Fixed, not changeable: Esc, Enter, Tab, the mouse, the number keys 1-9 and the arrow keys. A key another action has is swapped with it. Left and right Shift, Ctrl and Alt count as one."/>
            <Border Style="{StaticResource PanelCard}" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowsPanel" Margin="10,6,10,8"/>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Footer: status left, one Accent button right -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                               Text="Save uses the new keys now and keeps them for your next walks. Cancel puts the old keys back."/>
                    <Button x:Name="ResetButton" Content="Reset to standard keys" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnResetClick"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="96"
                            Margin="0,0,16,0" Click="OnSaveClick"/>
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="88"
                            IsCancel="True" Click="OnCancelClick" ToolTip="Close and keep the keys as they were (Esc)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
