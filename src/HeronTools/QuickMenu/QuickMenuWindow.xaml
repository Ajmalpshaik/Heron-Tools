<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Quick Menu (wheel): the radial tool wheel that opens around the mouse pointer. Everything on it is drawn
  in code-behind (QuickMenuWindow.xaml.cs), because the number of slots is the modeller's own setting - this
  XAML only provides the transparent shell, the pop-in transform and the canvas.
  Heron brand: Ink / Surface ring, Mist text, the hovered slot lit in Accent, the heron mark in the hub.
  Motion (code-behind): the ring springs open and the slots unfold from the hub clockwise; an Accent
  selector arc and hub needle glide to the slot under the pointer, which steps out and lights up; the ring
  drops back as it closes. Off when Windows' "Show animations" is off.
  The shell is deliberately plain: a see-through window is drawn by the CPU, so no blur, effect or
  whole-window opacity animation belongs on it - only transforms and the small slot glows animate, and the
  soft halo behind the ring is a static gradient brush.
-->
<Window x:Class="HeronTools.UI.QuickMenu.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Menu - Heron Tools"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Focusable="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Width="600"
        Height="600">

    <!-- 1/255 alpha: invisible, but the whole square still receives the clicks, so a click in a
         corner (outside the ring) can close the wheel the way it does in a game. -->
    <Grid x:Name="RootGrid"
          Background="#01000000"
          TextElement.FontFamily="Manrope, Segoe UI"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Canvas x:Name="WheelCanvas"/>
    </Grid>
</Window>
