<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  About Heron: one window for the Heron family - which Heron Tools version is running here, in which
  Revit, and what the two Heron products are, with their GitHub links. Heron brand design (HeronStyles.xaml).
-->
<Window x:Class="HeronTools.UI.AboutHeronWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Heron"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the heron mark, large, on Ink -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDark}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel Orientation="Horizontal">
                <!-- The glowing glass heron from the brand kit (3D.png), on the Ink header. -->
                <Image x:Name="hero_image" Width="96" Height="96" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Heron" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="BIM tools for Revit, by Ajmal PS" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The middle scrolls when the window is held to the screen height (ScreenFit), so the buttons stay in view. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- This add-in -->
            <Border Style="{StaticResource PreviewCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource CardMark}"/>
                    <StackPanel>
                        <TextBlock Text="RUNNING HERE" Style="{StaticResource Overline}"/>
                        <TextBlock x:Name="product_text" Text="Heron Tools 1.0.0" Style="{StaticResource PreviewName}"/>
                        <TextBlock x:Name="environment_text" Text="Revit 2024  |  .NET Framework 4.8" Style="{StaticResource StepCount}" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The family -->
            <Border Style="{StaticResource StepCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="The Heron family" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Both live on the Heron ribbon tab. Each can be installed on its own; together they share one tab."
                               Style="{StaticResource HelpText}" Margin="0,0,0,12"/>

                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="tools_link_button" DockPanel.Dock="Right" Content="GitHub" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" ToolTip="github.com/Ajmalpshaik/Heron-Tools"/>
                        <StackPanel>
                            <TextBlock Text="Heron Tools" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Everyday modelling tools: filters, colours, crops, datums, levels, links, worksets."
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <Button x:Name="ai_link_button" DockPanel.Dock="Right" Content="GitHub" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" ToolTip="github.com/Ajmalpshaik/Heron-AI"/>
                        <StackPanel>
                            <TextBlock Text="Heron AI" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Drive Revit in plain words - a separate product and install."
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,14,0,0" Style="{StaticResource HelpText}"
                       Text="Free and open source under the Apache License 2.0. The Heron name and mark are not covered by the licence. Autodesk and Revit are trademarks of Autodesk, Inc."/>
        </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <Button x:Name="close_button" DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}"
                        MinWidth="88" IsCancel="True"/>
                <Button x:Name="copy_button" DockPanel.Dock="Right" Content="Copy version details" Style="{StaticResource PrimaryButton}"
                        MinWidth="170" Margin="0,0,8,0"
                        ToolTip="Copies the version, Revit and .NET details - handy when reporting a problem."/>
                <TextBlock x:Name="status_text" Text="" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
