<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Link Workset (Heron Tools): tick Revit links and CAD imports and put them on a user workset (an existing
  one, or a new one by typed name). Workshared models only. Heron brand theme (HeronStyles.xaml).
-->
<Window x:Class="HeronTools.UI.SetLinkWorksetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Workset - Heron Tools"
        Width="540"
        Height="660"
        MinWidth="480"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Link Workset" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Put Revit links and CAD imports on a workset."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Which links -->
            <Border Grid.Row="0" Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select all" Style="{StaticResource LinkButton}"
                                    Click="OnSelectAll" ToolTip="Tick every link"/>
                            <TextBlock Text="·" Foreground="{StaticResource TextDisabled}" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Content="None" Style="{StaticResource LinkButton}"
                                    Click="OnSelectNone" ToolTip="Untick every link"/>
                            <TextBlock Text="·" Foreground="{StaticResource TextDisabled}" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Content="Invert" Style="{StaticResource LinkButton}"
                                    Click="OnInvertSelection" ToolTip="Swap ticked and unticked"/>
                        </StackPanel>
                        <TextBlock Text="Links and CAD imports" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock x:Name="links_count_text"
                               Grid.Row="1"
                               Style="{StaticResource StepCount}"
                               Margin="0,0,0,8"/>

                    <ListBox Grid.Row="2"
                             x:Name="links_listbox"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="0,2"
                                          ToolTip="{Binding Name}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Shown over the empty list. A DataTrigger here, because the theme's EmptyHint Tag trigger
                         compares the bool HasItems with the text "False" and so never fires. -->
                    <TextBlock Grid.Row="2" Text="This model has no Revit links or CAD imports.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=links_listbox}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 2. Which workset -->
            <Border Grid.Row="1" Style="{StaticResource StepCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Move them to this workset" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="workset_combobox"
                              Height="34"
                              Margin="0,6,0,8"
                              IsEditable="True"
                              ToolTip="Pick a user workset, or type a new name"/>
                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Pick a workset, or type a new name - a new workset is made with that name."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Result / reason line; collapsed until there is something to say. -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="assign_workset_button"
                            Content="Move to workset"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="140"
                            Margin="0,0,8,0"
                            Click="OnAssignWorkset"
                            ToolTip="Put the ticked links on the workset (one Undo step)"/>
                    <Button Content="Close"
                            Style="{StaticResource GhostButton}"
                            IsCancel="True"
                            MinWidth="88"
                            ToolTip="Close (Esc)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
