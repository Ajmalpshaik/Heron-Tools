<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  View Crop - settings and scope for "Crop View by Elements".
  Left: what the crop fits around and which views. Right: the margin and what else counts.
  Bottom: the optional annotation crop. Footer: status left, ONE Accent action right.
  Design: Heron brand kit via HeronStyles.xaml (same layout language as Filter Pro).
-->
<Window x:Class="HeronTools.UI.ViewCrop.ViewCropOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop View by Elements - Heron Tools"
        Width="860"
        MinWidth="780"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- A field label that greys out with the field it labels. -->
            <Style x:Key="ToggleFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Help line under a tick box or radio, indented to sit under its text. -->
            <Style x:Key="OptionHelp" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                <Setter Property="Margin" Value="28,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>   <!-- body -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                        Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Crop View by Elements" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Fit each plan view's crop region tightly around the model, with the margin you choose."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY ============ -->
        <!-- The middle scrolls when the window is held to the screen height (ScreenFit), so the buttons stay in view. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LEFT: what the crop fits around + which views -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Border Style="{StaticResource StepCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Fit the crop around" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <RadioButton x:Name="ModeAllModelRadio" Content="All model elements" IsChecked="True"
                                     Style="{StaticResource ModernRadioButton}"/>
                        <TextBlock Text="The whole project footprint, whatever each view shows." Style="{StaticResource OptionHelp}"/>
                        <RadioButton x:Name="ModeVisibleRadio" Content="What each view shows"
                                     Style="{StaticResource ModernRadioButton}"/>
                        <TextBlock Text="Only the elements visible in that view." Style="{StaticResource OptionHelp}" Margin="28,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock Text="Views" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ActiveViewOnlyRadio" Content="Active view" IsChecked="True"
                                         Style="{StaticResource ModernRadioButton}" Margin="0,0,20,0"
                                         Checked="OnApplyScopeChanged" Unchecked="OnApplyScopeChanged"/>
                            <RadioButton x:Name="MultipleViewsRadio" Content="Pick several views"
                                         Style="{StaticResource ModernRadioButton}"
                                         Checked="OnApplyScopeChanged" Unchecked="OnApplyScopeChanged"/>
                        </StackPanel>
                        <TextBlock Text="With several views, the next window lists the plan views to pick from."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: margin + what else counts -->
            <StackPanel Grid.Row="0" Grid.Column="2">
                <Border Style="{StaticResource StepCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Margin around the model" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Preset" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PresetComboBox" SelectionChanged="OnPresetChanged"
                                          ToolTip="Pick a common margin, or type your own in Margin"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margin (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MarginTextBox" Style="{StaticResource ModernTextBox}"
                                         TextChanged="OnMarginTextChanged"
                                         ToolTip="Space left between the model and the crop edge, in millimetres"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock Text="Also count" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="IncludeLinksCheckBox" Content="Revit links" Style="{StaticResource ModernCheckBox}"/>
                        <TextBlock Text="Fit around the elements inside linked models." Style="{StaticResource OptionHelp}"/>
                        <CheckBox x:Name="IncludeCoordinationModelsCheckBox" Content="Coordination models" Style="{StaticResource ModernCheckBox}"/>
                        <TextBlock Text="Navisworks models placed in this project (not linked ones)." Style="{StaticResource OptionHelp}"/>
                        <CheckBox x:Name="IncludeDatumsCheckBox" Content="Levels, grids and reference planes" Style="{StaticResource ModernCheckBox}"/>
                        <TextBlock Text="Datum lines push the crop out to their ends." Style="{StaticResource OptionHelp}"/>
                        <CheckBox x:Name="IgnoreHiddenCheckBox" Content="Skip hidden categories" Style="{StaticResource ModernCheckBox}"/>
                        <TextBlock Text="Leave out hidden categories, hidden elements and links the view hides (&quot;What each view shows&quot; never counts them anyway)." Style="{StaticResource OptionHelp}" Margin="28,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- BOTTOM: annotation crop (optional) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="ApplyAnnotationCheckBox" Content="Also turn on the annotation crop"
                                  Style="{StaticResource ModernCheckBox}"
                                  Checked="OnApplyAnnotationToggled" Unchecked="OnApplyAnnotationToggled"/>
                        <TextBlock Text="Sets the annotation crop just outside the new view crop, in the same run."
                                   Style="{StaticResource OptionHelp}" Margin="28,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="AnnotationOffsetLabel" Grid.Column="2" Text="Offset on paper (mm)"
                               Style="{StaticResource ToggleFieldLabel}" VerticalAlignment="Center"
                               Margin="0,0,10,0" IsEnabled="False"/>
                    <TextBox x:Name="AnnotationOffsetTextBox" Grid.Column="3" Text="25"
                             Style="{StaticResource ModernTextBox}" IsEnabled="False"
                             ToolTip="How far outside the view crop the annotation crop sits, in millimetres"/>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ============ FOOTER ============ -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="{StaticResource AccentWarning}" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DiagnosticsButton" Content="Crop and show why" Style="{StaticResource SecondaryButton}"
                            MinWidth="150" Margin="0,0,8,0" Click="OnDiagnosticsRun"
                            ToolTip="Crops the same way, then lists which element set each edge of the new crop. It changes the crop - it is not a preview."/>
                    <Button x:Name="RunButton" Content="Crop view" Style="{StaticResource PrimaryButton}"
                            MinWidth="150" Margin="0,0,16,0" Click="OnRun"/>
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="88"
                            IsCancel="True" Click="OnCancel"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
