    </Style>

    <Style x:Key="ModernListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <!-- Hover is an overlay, not a Background swap: a long list stays cheap and the
                             wash reads the same over a selected (blue) row as an unselected one. -->
                        <Border x:Name="HoverGlow" CornerRadius="6" BorderThickness="1"
                                Background="#18FFFFFF" BorderBrush="{StaticResource BorderSoft}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <!-- Picked: Accent at 16 % with an Accent edge (brand: Accent used sparingly). -->
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentEdge}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernListBoxItemSuccess" TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="HoverGlow" CornerRadius="6" BorderThickness="1"
                                Background="#18FFFFFF" BorderBrush="{StaticResource BorderSoft}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSuccess}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentSuccess}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Selection (templated v1.4.0). These three were setter-only until now, so every tick box and
         radio button in the suite was drawing raw Windows chrome inside an otherwise soft, rounded,
         Neon-Blue UI - the last big visual inconsistency left.

         The original Setters (Foreground / VerticalAlignment / FontSize / Margin) are all kept exactly
         as they were, so nothing moves on any window.

         These are KEYED styles on purpose - no implicit TargetType="CheckBox" style. An implicit one
         would also capture the CheckBox that DataGridCheckBoxColumn generates (Duct Standards has one),
         where the animated tick would replay every time a row scrolled into view. Same rule as
         selection and the Graphics Override category list: animate what the user changed, not what
         merely appeared.

         Checked 2026-08-05 before templating: nothing in the project uses IsThreeState or sets
         IsChecked to null, so there is no indeterminate state to represent.
         ============================================================ -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background so the label is clickable too, not just the 18px box. -->
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BoxPressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Box" CornerRadius="6"
                                    Background="{StaticResource BackgroundDark}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"/>
                            <!-- The accent fill fades in rather than snapping, and owns only IsChecked. -->
                            <Border x:Name="BoxFill" CornerRadius="6"
                                    Background="{StaticResource Accent}" Opacity="0"/>
                            <Border x:Name="BoxHover" CornerRadius="6"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="BoxFocus" CornerRadius="6"
                                    BorderBrush="#99FFFFFF" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Path x:Name="Tick"
                                  Data="M 0 4 L 4 8 L 11 0"
                                  Width="11" Height="8" Stretch="Uniform"
                                  Stroke="{StaticResource TextOnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="TickScale" ScaleX="0.5" ScaleY="0.5"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.5" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.5" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFocus" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFocus" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The list variant: identical box, but the TICK IS INSTANT. Use this for any checkbox inside a
         scrolling list or a DataTemplate. Those containers are created and recycled as rows scroll into
         view, so an animated tick would replay on every scroll and read as flicker running down the
         list. Hover, press and focus still animate - those fire on user action, not on materialization.
         Same rule as list selection and the Graphics Override category list. -->
    <Style x:Key="ModernListCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BoxPressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Box" CornerRadius="6"
                                    Background="{StaticResource BackgroundDark}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"/>
                            <Border x:Name="BoxFill" CornerRadius="6"
                                    Background="{StaticResource Accent}" Opacity="0"/>
                            <Border x:Name="BoxHover" CornerRadius="6"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <!-- This style inherits FocusVisualStyle="{x:Null}" from ModernCheckBox, so
                                 without this ring a keyboard user would have NO indication of where
                                 they are. Nulling the OS focus rectangle obliges us to draw our own. -->
                            <Border x:Name="BoxFocus" CornerRadius="6"
                                    BorderBrush="#99FFFFFF" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Path x:Name="Tick"
                                  Data="M 0 4 L 4 8 L 11 0"
                                  Width="11" Height="8" Stretch="Uniform"
                                  Stroke="{StaticResource TextOnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Opacity="0"/>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Plain Setters, not storyboards - this is the whole point of this variant. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxFill" Property="Opacity" Value="1"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFocus" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxFocus" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Named a switch since v1.0 but drawn as a tick box until now. It is used for genuine on/off
         settings ("Update existing filters"), which is exactly what a switch is for, so it looks like one.
         The knob SLIDES its 20px (track 40, knob 14, 3px inset each side) instead of jumping. -->
    <Style x:Key="ToggleSwitchCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{StaticResource BackgroundDark}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"/>
                            <Border x:Name="TrackOn" CornerRadius="10"
                                    Background="{StaticResource Accent}" Opacity="0"/>
                            <Border x:Name="TrackHover" CornerRadius="10"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <!-- Same obligation as the list box above: FocusVisualStyle is nulled by
                                 the base style, so the keyboard marker has to be drawn here. -->
                            <Border x:Name="TrackFocus" CornerRadius="10"
                                    BorderBrush="#99FFFFFF" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     Fill="{StaticResource TextPrimary}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobSlide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackFocus" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackFocus" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="DotPressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Ring"
                                     Fill="{StaticResource BackgroundDark}"
                                     Stroke="{StaticResource BorderStrong}" StrokeThickness="1"/>
                            <Ellipse x:Name="RingOn" Stroke="{StaticResource Accent}" StrokeThickness="1"
                                     Opacity="0"/>
                            <Ellipse x:Name="RingHover" Stroke="{StaticResource Accent}" StrokeThickness="1"
                                     Opacity="0" IsHitTestVisible="False"/>
                            <Ellipse x:Name="RingFocus" Stroke="#99FFFFFF" StrokeThickness="1"
                                     Opacity="0" IsHitTestVisible="False"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="0.4" ScaleY="0.4"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.4" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.4" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotPressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotPressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingFocus" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingFocus" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernGroupBox" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <!-- Own template: Windows' default GroupBox draws a white double line, which is not a brand colour.
             This one is a rounded Surface card with a Mist 14 % line and the header above the content. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              Margin="12,10,12,4"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.FontWeight="Normal"
                                              TextElement.FontSize="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource BackgroundDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="TabContent"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <!-- Same margin as TabBorder so the hover edge lines up exactly. -->
                        <Border x:Name="HoverGlow" Margin="0,0,4,0" CornerRadius="8,8,0,0"
                                BorderThickness="1,1,1,0" BorderBrush="{StaticResource Accent}"
                                Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{StaticResource TextOnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress. The default WPF bar is the old green/blue Aero one and looks foreign in these
         windows; this is the house version. Determinate is driven by the control itself
         (PART_Track / PART_Indicator are the names ProgressBar looks for - don't rename them).
         Indeterminate gets a slow breathe so a busy state reads as alive rather than stuck. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="6"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BusyPulse">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.35" Duration="0:0:0.9"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BusyPulse"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BackgroundDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>


    <!-- ============================================================
         Heron layout pieces (2026-11-07 redesign). Same palette, nothing new:
         Ink / Surface / Mist shades / one Accent. Radius: cards 12, controls 6, tiles 11.
         ============================================================ -->

    <!-- Header -->
    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="HeaderSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- A small rounded label: "Active view  Level 1". -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style x:Key="ChipLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Cards -->
    <Style x:Key="StepCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- The preview card carries a thin Accent edge on the left: the one place the eye should go first. -->
    <Style x:Key="PreviewCard" TargetType="Border" BasedOn="{StaticResource StepCard}">
        <Setter Property="Padding" Value="16,14"/>
    </Style>
    <!-- The short bar that marks a card: Accent for the preview, Warning for the skipped list. -->
    <Style x:Key="CardMark" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <Style x:Key="ReportCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="ReportTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Step number. Outline while the step is empty; filled Accent once something is picked
         (Tag is bound to the list's SelectedItem). -->
    <Style x:Key="StepBadge" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StepBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Null}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StepTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="StepCount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Section text -->
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
    </Style>
    <Style x:Key="PreviewName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="HelpText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Shown over an empty list (Tag bound to the list's HasItems). A DataTrigger, because a plain Trigger
         on Tag (an object) compares the TEXT "False" with the true/false value and never fires. -->
    <Style x:Key="EmptyHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="20"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Search box: the field with a search glyph and a hint (Tag) while empty. -->
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Padding" Value="30,6,8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FieldFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"
                                   VerticalAlignment="Center" Margin="31,0,8,0"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                        <!-- No Margin here: the TextBox already applies its Padding inside the content host,
                             and applying it twice pushed typed text about 60 px in. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <Border x:Name="FocusRing" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource Accent}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only button for small actions (Select all, Clear, Refresh). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,2">
                        <ContentPresenter x:Name="Content" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Content" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet button with no fill (Close). -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <!-- Tabs inside the right-hand card: flat headers with an Accent underline on the open one. -->
    <Style x:Key="RailTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="10,0">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RailTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="6,0">
                        <ContentPresenter ContentSource="Header" Margin="6,12,6,11"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{StaticResource Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Scroll bars: a slim Mist thumb on a clear track, wider while hovered. No arrows. -->
    <Style x:Key="HeronScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFill" CornerRadius="3" Background="{StaticResource BorderStrong}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource TextSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HeronScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="2,1">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource HeronScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>