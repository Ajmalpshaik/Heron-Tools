    <!-- ============================================================
         Brand colours as raw values (for gradients)
         ============================================================ -->
    <Color x:Key="InkColor">#FF0F0F10</Color>
    <Color x:Key="AccentColor">#FFFD641A</Color>
    <Color x:Key="AccentLightColor">#FFFF9A5C</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#FF0F0F10"/>   <!-- Ink -->
    <SolidColorBrush x:Key="BackgroundMedium" Color="#FF1B1B1F"/> <!-- Surface -->
    <SolidColorBrush x:Key="BackgroundLight" Color="#14F7F5F2"/>  <!-- Mist 8 % fill -->
    <SolidColorBrush x:Key="CardBackground" Color="#FF1B1B1F"/>   <!-- Surface -->

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent" Color="#FFFD641A"/>           <!-- Accent -->
    <SolidColorBrush x:Key="AccentSuccess" Color="#FF3ECF8E"/>    <!-- Success -->
    <SolidColorBrush x:Key="AccentWarning" Color="#FFF5A524"/>    <!-- Warning -->
    <SolidColorBrush x:Key="AccentGray" Color="#24F7F5F2"/>       <!-- Mist 14 %: quiet button fill -->
    <SolidColorBrush x:Key="AccentDanger" Color="#FFFF5A4E"/>     <!-- Error -->
    <SolidColorBrush x:Key="AccentSoft" Color="#29FD641A"/>       <!-- Accent 16 %: picked row -->
    <SolidColorBrush x:Key="AccentEdge" Color="#B3FD641A"/>       <!-- Accent 70 %: picked row edge -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EBF7F5F2"/>      <!-- Mist 92 % -->
    <SolidColorBrush x:Key="TextSecondary" Color="#B8F7F5F2"/>    <!-- Mist 72 % -->
    <SolidColorBrush x:Key="TextDisabled" Color="#8CF7F5F2"/>     <!-- Mist 55 % -->
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>     <!-- White on Accent -->
    <SolidColorBrush x:Key="TextSuccess" Color="#FF3ECF8E"/>      <!-- Success -->

    <!-- Lines / overlay -->
    <SolidColorBrush x:Key="BorderSoft" Color="#24F7F5F2"/>       <!-- Mist 14 % -->
    <SolidColorBrush x:Key="BorderStrong" Color="#47F7F5F2"/>     <!-- Mist 28 % -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#CC0F0F10"/> <!-- Ink 80 % -->

    <!-- Aliases used by the templates below -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFD641A"/>

    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#CCFD641A"/> <!-- Accent 80 % -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0F0F10"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="SoftCardBrush" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EBF7F5F2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B8F7F5F2"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#24F7F5F2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5A4E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF3ECF8E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF5A524"/>


    <!-- ============================================================
         Motion (v1.3.0) - one shared feel for every Heron Tools control.

         Timing budget (motion-design): hover under 100ms, press under 150ms,
         release/settle 200-300ms. Everything decelerates (CubicEase EaseOut) so a
         control reads as finished well before it stops moving. Deliberately short:
         these are working dialogs opened many times a day, not a showcase.

         TWO HOUSE RULES BAKED IN BELOW - keep them if this file is edited:
         1. NEVER animate Background or Foreground here. Several windows set those two
            directly from code-behind (About's nav buttons, PipeSizing's mode toggles),
            and a running animation outruns a locally-set value, which would break the
            state colouring. Animate an overlay element's Opacity or a RenderTransform
            instead - both are template-internal, so no code-behind can collide with them.
         2. ONE trigger per animated property. Hover, press and focus each drive their own
            overlay, so they can never fight over who wrote last when several are true at
            once (hovering while pressed, pressing while focused).
         ============================================================ -->
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut"/>

    <!-- Typography -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="30"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="DisabledText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- No implicit Foreground to keep button text contrast correct -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Background" Value="{StaticResource BorderSoft}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Replaced by the animated FocusRing below - the OS dotted rectangle would sit outside the
             rounded corner and fight the house look. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Layout is unchanged from v1.2.0: InnerFill still owns the padding and the
                         content, so no button changes size. The three overlays sit on top of it and
                         only ever have their Opacity animated. -->
                    <Grid x:Name="Root" Margin="2" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="InnerFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- Hover lift: a soft white wash. Works over every button colour (blue, grey,
                             green, red, and anything a window sets from code-behind). -->
                        <Border x:Name="HoverGlow" CornerRadius="6" Background="#1FFFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <!-- Press shade: matches the old 0.7-opacity dim, but eased. -->
                        <Border x:Name="PressShade" CornerRadius="6" Background="#33000000"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="6" BorderBrush="#99FFFFFF" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Foreground stays a plain Setter on purpose: a Setter loses to a
                                 code-behind local value, an animation would not. -->
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Buttons -->
    <!-- (The borderless-window title-bar buttons were removed: Heron Tools windows use the standard title bar.) -->

    <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentGray}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentSuccess}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentSuccess}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentDanger}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="CompactSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- A dropdown-style ToggleButton (Linked Search's model picker). It had NO template, so it drew
         default Windows chrome AND repainted itself on the checked state, which left the label barely
         readable while the dropdown was open. This template never touches Foreground or Background, so
         the caller's colours - and the label - stay exactly as set in both states; "open" is shown with
         an accent ring instead. -->
    <Style x:Key="ModernDropdownToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="HoverGlow" CornerRadius="6" Background="#1FFFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="OpenRing" CornerRadius="6"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="6"
                                BorderBrush="#99FFFFFF" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OpenRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OpenRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- The blue edge used to be an instant BorderBrush swap. It is now two rings
                         that fade: one owned by hover, one by focus, so neither can overwrite the
                         other when the box is hovered AND focused. The field's own BorderBrush is
                         left alone, so a window can still colour it from code-behind. -->
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FieldFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="HoverRing" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource Accent}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource Accent}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ModernComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="ComboToggleBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Path x:Name="ComboArrow"
                      Data="M 0 0 L 5 5 L 10 0 Z"
                      Fill="{StaticResource TextSecondary}"
                      Width="10"
                      Height="5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ComboArrowRotate" Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="ComboArrow" Property="Fill" Value="{StaticResource Accent}"/>
                <!-- The arrow turns to point up while the list is open, and back when it closes. -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                             To="180" Duration="0:0:0.18"
                                             EasingFunction="{StaticResource MotionEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.18"
                                             EasingFunction="{StaticResource MotionEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboToggleBorder" Property="Opacity" Value="0.7"/>
                <Setter TargetName="ComboArrow" Property="Fill" Value="{StaticResource TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Template="{StaticResource ModernComboToggleTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="10,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False"/>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="10,0,30,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{StaticResource Accent}"
                                 Visibility="Hidden"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,8,8"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer Margin="2"
                                              SnapsToDevicePixels="True"
                                              CanContentScroll="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- Highlight fades in as an overlay so it reads the same over an unselected
                             row and over the blue selected row. Selection itself stays instant. -->
                        <Border x:Name="HighlightGlow" CornerRadius="6" BorderThickness="1"
                                Background="#18FFFFFF" BorderBrush="{StaticResource Accent}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ComboItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="ComboItemBorder" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists -->
    <Style x:Key="ModernListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundMedium}"/>
