<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Element ID (Heron Tools): shows the Element ID of the element the modeller picked and the model it
  belongs to (this model or a link), with a Copy button. Reads only. Heron brand theme (HeronStyles.xaml).
-->
<Window x:Class="HeronTools.UI.LinkedIdViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element ID - Heron Tools"
        MinWidth="460"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Element ID" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="The ID of the element you picked, and the model it lives in."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Style="{StaticResource StepCard}" Margin="24,20,24,20">
            <StackPanel>
                <TextBlock Text="Element ID" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ElementIdBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         FontSize="16"
                         FontWeight="SemiBold"
                         HorizontalScrollBarVisibility="Auto"
                         ToolTip="Read only. Copy it with the Copy ID button, or select it and press Ctrl+C."
                         Margin="0,0,0,14"/>

                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ModelSourceBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         HorizontalScrollBarVisibility="Auto"
                         ToolTip="This model, or the name of the linked model the element belongs to."/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoText"
                           Grid.Column="0"
                           Text="Copy the ID to use it in a filter, a schedule or Find by Element ID."
                           TextWrapping="Wrap"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           Margin="0,0,16,0"
                           Foreground="{StaticResource TextSecondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Copy ID"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnCopyId"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            ToolTip="Copy the Element ID to the clipboard"/>
                    <Button Content="Close"
                            Style="{StaticResource GhostButton}"
                            Click="OnClose"
                            IsCancel="True"
                            MinWidth="88"
                            ToolTip="Close (Esc)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
