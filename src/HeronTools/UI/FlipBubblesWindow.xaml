<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Flip Bubbles (Heron Tools): choose how to pick grids and levels - one by one (each flips at once) or by
  window. A click on a card chooses; 1 / 2 pick by keyboard, Enter takes the last-used one, Esc cancels.
  Heron brand theme (HeronStyles.xaml). The drawings on the cards use brand brushes only.
-->
<Window x:Class="HeronTools.UI.FlipBubblesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flip Bubbles - Heron Tools"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Revit's grid line: dash-dot, quiet. -->
            <Style x:Key="GridLine" TargetType="Line">
                <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeDashArray" Value="5 2 1 2"/>
            </Style>
            <!-- The bubble where it is now (about to move): dashed and quiet. -->
            <Style x:Key="OldBubble" TargetType="Ellipse">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stroke" Value="{StaticResource BorderStrong}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeDashArray" Value="2 1.5"/>
            </Style>
            <!-- The bubble where it goes: solid Accent - the one thing the eye should land on. -->
            <Style x:Key="NewBubble" TargetType="Ellipse">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stroke" Value="{StaticResource Accent}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="Fill" Value="{StaticResource AccentSoft}"/>
            </Style>
            <Style x:Key="Illustration" TargetType="Border">
                <Setter Property="Height" Value="112"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="{StaticResource BackgroundDark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Flip Bubbles" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Swap which end of a grid or level shows its bubble."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="24,18,24,22">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="How do you want to pick?" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" Margin="0"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="View" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="ViewNameText" Style="{StaticResource ChipValue}" MaxWidth="240"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1  Pick one by one -->
                <Button x:Name="PickTile" Grid.Column="0" Style="{StaticResource ChoiceTile}"
                        AutomationProperties.Name="Pick one by one"
                        ToolTip="Click grids or levels one at a time. Each bubble flips the moment you click. Esc when done.">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource Illustration}">
                                <Viewbox Width="132" Height="92">
                                    <Canvas Width="120" Height="84">
                                        <Line X1="56" Y1="22" X2="56" Y2="62" Style="{StaticResource GridLine}"/>
                                        <Ellipse Canvas.Left="48" Canvas.Top="5" Style="{StaticResource OldBubble}"/>
                                        <Ellipse Canvas.Left="48" Canvas.Top="63" Style="{StaticResource NewBubble}"/>
                                        <!-- the swap -->
                                        <Path Data="M 70,14 C 86,24 86,58 71,69" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 70,62 L 71,69 L 78,67" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <!-- the cursor, clicking the line -->
                                        <Path Data="M 52,38 L 52,54 L 56,50 L 59,57 L 61.5,56 L 58.5,49 L 64,49 Z"
                                              Fill="{StaticResource TextPrimary}" Stroke="{StaticResource BackgroundDark}"
                                              StrokeThickness="1" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <Border x:Name="PickLastUsed" Style="{StaticResource AccentTag}" Margin="8" Visibility="Collapsed">
                                <TextBlock Text="Last used" Style="{StaticResource AccentTagText}"/>
                            </Border>
                        </Grid>
                        <DockPanel Margin="2,14,2,0">
                            <Border DockPanel.Dock="Right" Style="{StaticResource KeyHint}">
                                <TextBlock Text="1" Style="{StaticResource KeyHintText}"/>
                            </Border>
                            <TextBlock Text="Pick one by one" Style="{StaticResource StepTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Margin="2,5,2,0" Style="{StaticResource HelpText}"
                                   Text="Click a grid or level and its bubble flips at once. Keep clicking."/>
                    </StackPanel>
                </Button>

                <!-- 2  Window select -->
                <Button x:Name="WindowTile" Grid.Column="2" Style="{StaticResource ChoiceTile}"
                        AutomationProperties.Name="Window select"
                        ToolTip="Drag a window around several grids or levels. Every bubble inside flips together. Esc when done.">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource Illustration}">
                                <Viewbox Width="132" Height="92">
                                    <Canvas Width="120" Height="84">
                                        <!-- the selection window -->
                                        <Rectangle Canvas.Left="14" Canvas.Top="31" Width="92" Height="24" RadiusX="2" RadiusY="2"
                                                   Fill="{StaticResource AccentSoft}" Stroke="{StaticResource Accent}"
                                                   StrokeThickness="1.25" StrokeDashArray="3 2"/>
                                        <Line X1="34" Y1="22" X2="34" Y2="62" Style="{StaticResource GridLine}"/>
                                        <Line X1="60" Y1="22" X2="60" Y2="62" Style="{StaticResource GridLine}"/>
                                        <Line X1="86" Y1="22" X2="86" Y2="62" Style="{StaticResource GridLine}"/>
                                        <Ellipse Canvas.Left="26" Canvas.Top="5" Style="{StaticResource OldBubble}"/>
                                        <Ellipse Canvas.Left="52" Canvas.Top="5" Style="{StaticResource OldBubble}"/>
                                        <Ellipse Canvas.Left="78" Canvas.Top="5" Style="{StaticResource OldBubble}"/>
                                        <Ellipse Canvas.Left="26" Canvas.Top="63" Style="{StaticResource NewBubble}"/>
                                        <Ellipse Canvas.Left="52" Canvas.Top="63" Style="{StaticResource NewBubble}"/>
                                        <Ellipse Canvas.Left="78" Canvas.Top="63" Style="{StaticResource NewBubble}"/>
                                        <!-- the cursor, finishing the drag at the corner -->
                                        <Path Data="M 104,53 L 104,69 L 108,65 L 111,72 L 113.5,71 L 110.5,64 L 116,64 Z"
                                              Fill="{StaticResource TextPrimary}" Stroke="{StaticResource BackgroundDark}"
                                              StrokeThickness="1" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <Border x:Name="WindowLastUsed" Style="{StaticResource AccentTag}" Margin="8" Visibility="Collapsed">
                                <TextBlock Text="Last used" Style="{StaticResource AccentTagText}"/>
                            </Border>
                        </Grid>
                        <DockPanel Margin="2,14,2,0">
                            <Border DockPanel.Dock="Right" Style="{StaticResource KeyHint}">
                                <TextBlock Text="2" Style="{StaticResource KeyHintText}"/>
                            </Border>
                            <TextBlock Text="Window select" Style="{StaticResource StepTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Margin="2,5,2,0" Style="{StaticResource HelpText}"
                                   Text="Drag a window around several - every bubble inside flips together."/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{StaticResource KeyHint}">
                        <TextBlock Text="Esc" Style="{StaticResource KeyHintText}"/>
                    </Border>
                    <TextBlock Text="finishes picking. The whole run is one Undo." FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}"
                        MinWidth="88" IsCancel="True" ToolTip="Close without picking (Esc)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
