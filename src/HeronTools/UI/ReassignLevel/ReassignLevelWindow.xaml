<!--
  Heron-Agent:  none
  Heron-Step:   1
  Heron-Status: DRAFT
  Heron-Since:  1.0.0
  Heron-Layer:  revit
  See docs/metadata-standard.md

  Reassign Level (Heron Tools): choose the scope (whole project or your current selection) and the level(s)
  for moving MEP elements to another reference level without moving them in space.
  Heron brand theme (HeronStyles.xaml).
-->
<Window x:Class="HeronTools.UI.ReassignLevel.ReassignLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reassign Level - Heron Tools"
        Width="520"
        MinWidth="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource BrandFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../HeronStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource BackgroundDark}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Viewbox Margin="9">
                        <Path Data="{StaticResource HeronMarkGeometry}" Fill="{StaticResource TextPrimary}" Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Reassign Level" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Move MEP elements to another level - they stay in place."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="24,20,24,20">

            <!-- 1. Which elements -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <TextBlock Text="Which elements" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="WholeProjectRadio"
                                     Content="Whole project"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadioButton}"
                                     Margin="0,0,24,0"
                                     ToolTip="Every supported MEP element on the From level, in the whole project"/>
                        <RadioButton x:Name="SelectedElementsRadio"
                                     Content="Only my selection"
                                     Style="{StaticResource ModernRadioButton}"
                                     ToolTip="Only the elements you selected in Revit before starting the tool"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Levels -->
            <Border Style="{StaticResource StepCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Levels" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>

                    <!-- From (whole project) -->
                    <StackPanel x:Name="FromPanel">
                        <TextBlock Text="From level" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FromCombo"
                                  Height="34"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLevelChanged"
                                  ToolTip="The level the elements use now"/>
                    </StackPanel>

                    <!-- What is selected (selection mode) -->
                    <StackPanel x:Name="SelectionInfoPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Elements to move" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="SelectionSummaryText"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="SwapButton"
                            Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,4"
                            Click="OnSwap"
                            ToolTip="Swap the From and To levels">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Swap From and To" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- To -->
                    <TextBlock Text="To level" Style="{StaticResource FieldLabel}" Margin="0,4,0,5"/>
                    <ComboBox x:Name="ToCombo"
                              Height="34"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnLevelChanged"
                              ToolTip="The level the elements will use instead"/>
                </StackPanel>
            </Border>

            <!-- 3. Before you run this -->
            <Border Style="{StaticResource PreviewCard}" Margin="0,12,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource CardMark}" Background="{StaticResource AccentWarning}"/>
                    <StackPanel>
                        <TextBlock Text="BEFORE YOU RUN THIS" Style="{StaticResource Overline}"/>
                        <TextBlock x:Name="NoteBodyText"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{StaticResource AccentWarning}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RunButton"
                            Content="Reassign"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OnRun"
                            ToolTip="Next you see how many elements will change, and can still cancel"/>
                    <Button Content="Cancel"
                            Style="{StaticResource GhostButton}"
                            MinWidth="88"
                            IsCancel="True"
                            Click="OnCancel"
                            ToolTip="Close without changing anything (Esc)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
